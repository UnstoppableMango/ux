cabal-version:   3.0
name:            ux
version:         0.0.12
synopsis:        Expressive artifact conversion pipelines
homepage:        https://github.com/UnstoppableMango/ux
license:         MIT
license-file:    LICENSE
build-type:      Simple
extra-doc-files: README.md

common warnings
  ghc-options:        -Wall
  default-extensions:
    LambdaCase
    OverloadedStrings

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Ux.Parser
    Ux.Syntax

  build-depends:
    , base                >=4.18 && <5
    , megaparsec          >=9.6  && <10
    , parser-combinators  >=1.3  && <2
    , text                >=2.0  && <3

  default-language: GHC2021

-- Bindings generated from TDL's protos by `make generate`.
library ir
  visibility:       public
  hs-source-dirs:   gen
  exposed-modules:
    Proto.Google.Protobuf.GoFeatures
    Proto.Google.Protobuf.GoFeatures_Fields
    Proto.Tdl.Ir.V1.Ir
    Proto.Tdl.Ir.V1.Ir_Fields
    Proto.Tdl.Plugin.V1.Plugin
    Proto.Tdl.Plugin.V1.Plugin_Fields

  build-depends:
    , base
    , proto-lens-protobuf-types  >=0.7 && <0.8
    , proto-lens-runtime         >=0.7 && <0.8

  default-language: Haskell2010

executable ux
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  other-modules:    Paths_ux
  autogen-modules:  Paths_ux
  build-depends:
    , base
    , megaparsec
    , text
    , ux

  default-language: GHC2021

test-suite spec
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:
    Ux.IrSpec
    Ux.ParserSpec

  build-depends:
    , base
    , hspec
    , hspec-megaparsec
    , megaparsec
    , microlens
    , proto-lens
    , text
    , ux
    , ux:ir

  default-language: GHC2021
